# Copy to .env and fill in. Never commit .env.

# PostgreSQL for the API (the local container from `bun run db:up` uses this)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cantonflow

# Port the API listens on
API_PORT=3001

# Canton ledger JSON API (the local ledger from `bun run ledger`)
LEDGER_API_URL=http://127.0.0.1:6864

# AI review provider (OpenAI-compatible). Add your own key.
AI_BASE_URL=https://api.meta.ai/v1
AI_MODEL=muse-spark-1.3
AI_API_KEY=
